{
  "name": "lvr3",
  "version-string": "25.2.3",
  "description": "LVR3 surface reconstruction dependencies for the vcpkg-first build path.",
  "dependencies": [
    "boost-date-time",
    "boost-filesystem",
    "boost-iostreams",
    "boost-mpi",
    "boost-serialization",
    "boost-thread",
    "boost-timer",
    "eigen3",
    "flann",
    "freeglut",
    "gdal",
    "gsl",
    "hdf5",
    "highfive",
    "lastools",
    "lz4",
    "tiff",
    "opencv4",
    "rply",
    {
      "name": "spdlog",
      "default-features": false
    },
    "tbb",
    "tl-expected",
    "yaml-cpp",
    "assimp"
  ],
  "features": {
    "draco": {
      "description": "Optional Draco support for supported I/O paths.",
      "dependencies": [
        "draco"
      ]
    },
    "pcl": {
      "description": "Optional PCL-enabled tools.",
      "dependencies": [
        "pcl"
      ]
    }
  }
}
