{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vcpkg-release",
      "displayName": "vcpkg-first (Release)",
      "description": "Configure with the vcpkg manifest/toolchain dependency path (default policy)",
      "binaryDir": "${sourceDir}/build-vcpkg-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_SHARED_LIBS": "ON",
        "LVR2_BUILD_STATIC_LIBS": "OFF",
        "LVR2_WITH_VCPKG": "ON",
        "LVR2_VCPKG_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "vcpkg-isolated-release",
      "displayName": "vcpkg-first isolated from system packages (Release)",
      "description": "Use vcpkg and disable CMake system/environment package paths except per-package LVR2_USE_SYSTEM_<PKG> opt-outs",
      "inherits": "vcpkg-release",
      "binaryDir": "${sourceDir}/build-vcpkg-isolated-release",
      "cacheVariables": {
        "LVR2_IGNORE_SYSTEM_PACKAGES": "ON"
      }
    },
    {
      "name": "vcpkg-system-tbb-tl-release",
      "displayName": "vcpkg-first with system TBB/tl-expected opt-outs (Release)",
      "description": "Use vcpkg for most packages while allowing system TBB and tl-expected through explicit per-package opt-outs",
      "inherits": "vcpkg-isolated-release",
      "binaryDir": "${sourceDir}/build-vcpkg-system-tbb-tl-release",
      "cacheVariables": {
        "LVR2_USE_SYSTEM_TBB": "ON",
        "LVR2_USE_SYSTEM_TL_EXPECTED": "ON"
      }
    },
    {
      "name": "system-optout-release",
      "displayName": "System-package escape hatch (Release)",
      "description": "Disable vcpkg for distributor builds that intentionally use system packages; prefer per-package LVR2_USE_SYSTEM_<PKG> options when mixing with vcpkg",
      "binaryDir": "${sourceDir}/build-system-optout-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "LVR2_WITH_VCPKG": "OFF",
        "LVR2_IGNORE_SYSTEM_PACKAGES": "OFF",
        "LVR2_USE_SYSTEM_TL_EXPECTED": "ON",
        "LVR2_USE_SYSTEM_TBB": "ON",
        "LVR2_USE_SYSTEM_SPDLOG": "ON",
        "BUILD_SHARED_LIBS": "ON",
        "LVR2_BUILD_STATIC_LIBS": "OFF",
        "LVR2_USE_SYSTEM_HIGHFIVE": "ON",
        "LVR2_USE_SYSTEM_RPLY": "ON",
        "LVR2_USE_SYSTEM_LASLIB": "ON"
      }
    },
    {
      "name": "sanitizer-vcpkg-debug",
      "displayName": "vcpkg-first sanitizer diagnostics (Debug)",
      "description": "Opt-in AddressSanitizer/UndefinedBehaviorSanitizer diagnostics; not used by default smoke presets",
      "inherits": "vcpkg-release",
      "binaryDir": "${sourceDir}/build-vcpkg-sanitizer-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "LVR2_BUILD_TESTS": "ON",
        "LVR2_ENABLE_SANITIZERS": "ON",
        "LVR2_SANITIZERS": "address;undefined",
        "LVR2_WITH_CUDA": "OFF",
        "LVR2_WITH_OPENCL": "OFF",
        "LVR2_WITH_PCL": "OFF",
        "LVR2_WITH_KINFU": "OFF"
      }
    },
    {
      "name": "fuzz-vcpkg-debug",
      "displayName": "vcpkg-first standalone fuzz seed runner (Debug)",
      "description": "Opt-in fuzz target and seed-corpus CTest hook; uses standalone runner unless LVR2_FUZZ_WITH_LIBFUZZER is overridden with Clang",
      "inherits": "sanitizer-vcpkg-debug",
      "binaryDir": "${sourceDir}/build-vcpkg-fuzz-debug",
      "cacheVariables": {
        "LVR2_ENABLE_FUZZING": "ON",
        "LVR2_FUZZ_WITH_LIBFUZZER": "OFF"
      }
    },
    {
      "name": "performance-baseline-vcpkg-release",
      "displayName": "vcpkg-first non-gating performance baselines (Release)",
      "description": "Opt-in baseline artifact recording; not used by default smoke presets",
      "inherits": "vcpkg-release",
      "binaryDir": "${sourceDir}/build-vcpkg-performance-baseline-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "LVR2_BUILD_TESTS": "ON",
        "LVR2_ENABLE_PERFORMANCE_BASELINES": "ON",
        "LVR2_WITH_CUDA": "OFF",
        "LVR2_WITH_OPENCL": "OFF",
        "LVR2_WITH_PCL": "OFF",
        "LVR2_WITH_KINFU": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-vcpkg-release",
      "configurePreset": "vcpkg-release",
      "configuration": "Release"
    },
    {
      "name": "build-vcpkg-isolated-release",
      "configurePreset": "vcpkg-isolated-release",
      "configuration": "Release"
    },
    {
      "name": "build-vcpkg-system-tbb-tl-release",
      "configurePreset": "vcpkg-system-tbb-tl-release",
      "configuration": "Release"
    },
    {
      "name": "build-system-optout-release",
      "configurePreset": "system-optout-release",
      "configuration": "Release"
    },
    {
      "name": "build-vcpkg-sanitizer-debug",
      "configurePreset": "sanitizer-vcpkg-debug",
      "configuration": "Debug"
    },
    {
      "name": "build-vcpkg-fuzz-debug",
      "configurePreset": "fuzz-vcpkg-debug",
      "configuration": "Debug"
    },
    {
      "name": "build-vcpkg-performance-baseline-release",
      "configurePreset": "performance-baseline-vcpkg-release",
      "configuration": "Release"
    }
  ]
}
