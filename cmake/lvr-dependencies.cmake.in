include(CMakeFindDependencyMacro)

list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}/Modules")

# Public/exported dependencies must exist before lvr2-targets.cmake is loaded.
find_dependency(tl-expected CONFIG)
find_dependency(spdlog CONFIG)

# HDF5 must be resolved before HighFive, because HighFive's package config may
# perform a C-only HDF5 lookup that leaves later CXX/HL component discovery in a
# partially initialized state.
# find_dependency(HDF5)
find_package(HDF5 REQUIRED COMPONENTS C CXX HL)

find_dependency(HighFive CONFIG)
find_dependency(rply CONFIG)
find_package(laslib CONFIG QUIET)
if(NOT TARGET LASlib AND NOT TARGET LASlib::LASlib)
  find_package(LASlib CONFIG REQUIRED)
endif()

find_dependency(TBB)
find_dependency(TIFF)
find_dependency(GDAL)
find_dependency(OpenCV)
find_dependency(FLANN)
find_dependency(LZ4)
find_dependency(GSL)
find_dependency(Eigen3)
find_dependency(yaml-cpp)
# find_dependency(OpenGL)
find_package(OpenGL COMPONENTS OpenGL)
find_dependency(GLUT)

if(@draco_FOUND@)
  find_dependency(draco CONFIG)
endif()

if(@OPENCL_FOUND@)
  find_dependency(OpenCL)
endif()

#####################
##  OPTIONAL DEPS  ##
#####################
if(@RDB_FOUND@)
  find_dependency(RDB)
endif()

# pcl
if(@PCL_FOUND@)
  find_dependency(MPI)
  find_dependency(PCL)
endif()

# cgal
if(@CGAL_FOUND@)
  find_dependency(CGAL)
endif()

# libfreenect
if(@LIBFREENECT_FOUND@)
  find_package(PkgConfig REQUIRED)
  pkg_check_modules(LIBFREENECT REQUIRED libfreenect)
endif()

# Embree
if(@embree_FOUND@)
  set_property(GLOBAL PROPERTY FIND_LIBRARY_USE_LIB64_PATHS ON)
  find_package(embree @LVR2_EMBREE_VERSION@ REQUIRED)
endif()
